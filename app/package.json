{
  "name": "deskrag-app",
  "version": "0.0.1",
  "description": "DeskRAGApp — desktop UI for DeskRAG local-first session memory",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "npm run build:ax && electron-vite build && electron-builder --config electron-builder.yml",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "test": "vitest run",
    "build:ax": "npm --prefix .. run build:ax"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.1.3",
    "@lancedb/lancedb": "^0.24.0",
    "better-sqlite3": "^12.4.1",
    "onnxruntime-node": "1.27.0",
    "sharp": "^0.35.3"
  },
  "optionalDependencies": {
    "@lancedb/lancedb-darwin-arm64": "^0.24.1",
    "active-win": "^8.2.1",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vidstack/react": "^1.15.6",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lottie-web": "^5.13.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "6.4.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "tar": "^7.5.21",
    "vite": "$vite"
  }
}
