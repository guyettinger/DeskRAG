{
  "name": "deskrag",
  "version": "0.0.1",
  "description": "Local-first multimodal desktop session memory (DeskRAG)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/guyettinger/DeskRAG"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",

    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "build:ax": "tsx scripts/gen/build-native.ts",

    "app:install": "npm --prefix app install",
    "app:dev": "npm run build && npm --prefix app run dev",
    "app:build": "npm run build && npm --prefix app run build",
    "app:dist": "npm run build && npm --prefix app run dist",

    "gen:brand": "tsx scripts/gen/brand/index.ts",
    "gen:shots": "npm run app:build && tsx scripts/gen/shots.ts",

    "smoke:onnx-electron": "npm run build && node scripts/smoke/onnx-electron-smoke.mjs",
    "smoke:e2e": "npm run build && node scripts/smoke/e2e-local.mjs",

    "probe:baseline": "tsx scripts/probes/baseline.ts",
    "probe:caption": "tsx scripts/probes/caption-width.ts",
    "probe:compose": "tsx scripts/probes/compose.ts",
    "probe:decimate": "tsx scripts/probes/decimate.ts",
    "probe:embed": "tsx scripts/probes/embed.ts",
    "probe:fork": "tsx scripts/probes/fork.ts",
    "probe:habits": "npm run app:build && tsx scripts/probes/habits.ts",
    "probe:highlight": "tsx scripts/probes/highlight.ts",
    "probe:latency": "tsx scripts/probes/capture-latency.ts",
    "probe:mcp": "npm run app:build && tsx scripts/probes/mcp.ts",
    "probe:merge": "npm run app:build && tsx scripts/probes/merge.ts",
    "probe:patchgeom": "tsx scripts/probes/patch-geometry.ts",
    "probe:reflect": "npm run app:build && tsx scripts/probes/reflect.ts",
    "probe:replay": "tsx scripts/probes/replay.ts",
    "probe:routes": "tsx scripts/probes/routes.ts",
    "probe:stability": "npm run app:build && tsx scripts/probes/stability.ts",
    "probe:transfer": "tsx scripts/probes/transfer.ts",
    "probe:tray": "npm run app:build && tsx scripts/probes/tray.ts",

    "dev:inspect-onnx": "tsx scripts/dev/inspect-onnx.ts",
    "dev:dump-tokens": "tsx scripts/dev/dump-colmodernvbert-tokens.ts",
    "dev:reindex-image-lane": "tsx scripts/dev/reindex-image-lane.ts"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.1.3",
    "@lancedb/lancedb": "^0.24.0",
    "apache-arrow": "18.1.0",
    "better-sqlite3": "^12.4.1",
    "onnxruntime-node": "1.27.0",
    "sharp": "^0.35.3",
    "ulid": "^3.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.9.2",
    "playwright-core": "^1.62.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "@lancedb/lancedb-darwin-arm64": "^0.24.1",
    "active-win": "^8.2.1",
    "uiohook-napi": "^1.5.5"
  },
  "overrides": {
    "tar": "^7.5.21",
    "vite": "6.4.3"
  }
}
